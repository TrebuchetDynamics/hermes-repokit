#!/bin/sh
# Generated by RepoKit. s6 runs this while the container stops, before its
# final kill. That kill comes 3s after SIGTERM, which cut Hermes gateways off
# mid-shutdown. Stop Hermes's own gateway slots through their supervisor and
# wait until each has exited, so Hermes finishes its own shutdown first.
# Nothing is signalled directly and Hermes's recorded intent is untouched: a
# restarted container brings back the gateways that were running.
set -u
set --
for slot in /run/service/gateway-*; do
  [ -d "$slot" ] && set -- "$@" "$slot"
done
[ "$#" -gt 0 ] || exit 0
# Hermes owns its slots' supervise directories; act as the hermes user.
exec /command/s6-setuidgid hermes /bin/sh -c \
  '/command/s6-svc -d -- "$@" && exec /command/s6-svwait -D -t 40000 -- "$@"' sh "$@"
