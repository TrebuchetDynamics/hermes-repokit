#!/bin/sh
# Native OpenViking environment and s6 lifecycle inside the Hermes container.
# This installed script has no dependency on the bootstrap executable.
set -eu
export HOME=/opt/data/openviking
export OPENVIKING_CONFIG_FILE=/opt/data/openviking/ov.conf
export OPENVIKING_CLI_CONFIG_FILE=/opt/data/openviking/ovcli.conf
export OPENVIKING_WITH_BOT=0
export OPENVIKING_SERVER_HOST=127.0.0.1
export OPENVIKING_PENDING_HOST=127.0.0.1
export OPENVIKING_SERVER_PORT=1933
export LD_LIBRARY_PATH=/opt/openviking-python/lib
export PATH=/app/.venv/bin:/opt/openviking-python/bin:/command:/usr/local/bin:/usr/bin:/bin
unset PYTHONHOME PYTHONPATH VIRTUAL_ENV OPENVIKING_CONF_CONTENT
umask 077
case "${1:-}" in
    serve)
        cd /opt/data/openviking
        exec /usr/local/bin/openviking-entrypoint --without-bot
        ;;
    server)
        shift
        cd /opt/data/openviking
        exec /app/.venv/bin/openviking-server "$@"
        ;;
    health)
        # /health is observational; /ready may invoke paid embeddings.
        if /usr/bin/curl --fail --silent --show-error --max-time 3 --max-filesize 4096 --noproxy '*' \
            http://127.0.0.1:1933/health | /usr/bin/jq -e '.status == "ok"' >/dev/null; then
            printf 'healthy\n'
        else
            printf 'degraded\n'
            exit 1
        fi
        ;;
    restart)
        # Restart only memory, never the gateway or its active workers.
        s6-svc -wD -T 15000 -d /run/service/repokit-openviking
        exec s6-svc -wu -T 15000 -u /run/service/repokit-openviking
        ;;
    *) echo 'Usage: repokit-openviking {server|health|restart}' >&2; exit 2 ;;
esac
