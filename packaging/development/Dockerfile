# Generated by RepoKit. Base already contains the checked baseline tools.
FROM {{HERMES_IMAGE}}
USER root
LABEL org.repokit.hermes.base="{{HERMES_IMAGE}}" \
      org.repokit.development.recipe={{RECIPE_HASH}}
RUN /opt/hermes/.venv/bin/python -I -c 'import hermes_cli'
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) arch=amd64; jq_sha=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f ;; \
      arm64) arch=arm64; jq_sha=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309 ;; \
      *) echo 'Unqualified development architecture' >&2; exit 1 ;; \
    esac; \
    curl --fail --show-error --silent --location --retry 3 --connect-timeout 15 --max-time 180 \
      "https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-linux-${arch}" -o /tmp/repokit-jq; \
    printf '%s  %s\n' "$jq_sha" /tmp/repokit-jq | sha256sum -c -; \
    install -m 0555 /tmp/repokit-jq /usr/local/bin/jq; \
    rm /tmp/repokit-jq
# Debian's docker-cli in the base does not include the Compose/Buildx plugins.
# Install official binaries, not a daemon. No socket is exposed by this recipe.
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) compose_arch=x86_64; buildx_arch=amd64; \
        compose_sha=db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576; \
        buildx_sha=9447199cdb435f25880548343c128a4b6650e8891ee598905d8d29d39a8e359b ;; \
      arm64) compose_arch=aarch64; buildx_arch=arm64; \
        compose_sha=732e3a84c1a0f67256ce80bc2598a24546b10ca05f9faa97efceb1171ece2ef7; \
        buildx_sha=e5cc9fe3bbff5cbc91230981f7860e06076110730a2db997082652199042a1f2 ;; \
      *) echo 'Unqualified Docker client architecture' >&2; exit 1 ;; \
    esac; \
    curl --fail --show-error --silent --location --retry 3 --connect-timeout 15 --max-time 300 \
      "https://github.com/docker/compose/releases/download/v5.5.1/docker-compose-linux-${compose_arch}" -o /tmp/repokit-compose; \
    curl --fail --show-error --silent --location --retry 3 --connect-timeout 15 --max-time 300 \
      "https://github.com/docker/buildx/releases/download/v0.37.1/buildx-v0.37.1.linux-${buildx_arch}" -o /tmp/repokit-buildx; \
    printf '%s  %s\n' "$compose_sha" /tmp/repokit-compose "$buildx_sha" /tmp/repokit-buildx | sha256sum -c -; \
    install -d -m 0755 /usr/local/lib/docker/cli-plugins; \
    install -m 0555 /tmp/repokit-compose /usr/local/lib/docker/cli-plugins/docker-compose; \
    install -m 0555 /tmp/repokit-buildx /usr/local/lib/docker/cli-plugins/docker-buildx; \
    rm /tmp/repokit-compose /tmp/repokit-buildx; \
    test "$(docker compose version --short)" = 5.5.1; \
    docker buildx version | grep -F ' v0.37.1 '
# Tools the team's granted skills rely on: ast-grep (structural code search)
# and ddgs (keyless web search). Pinned by checksum like the tools above.
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) sg_arch=x86_64; sg_sha=f8ac830881339d1edee6b2652f54798c0f4da5a827f2db38a08ee31117783ce8 ;; \
      arm64) sg_arch=aarch64; sg_sha=b39cfbc58da4b869a88b8a4bc57bd5deb0d24541e704cf7c257da7b53ec81c8f ;; \
      *) echo 'Unqualified ast-grep architecture' >&2; exit 1 ;; \
    esac; \
    curl --fail --show-error --silent --location --retry 3 --connect-timeout 15 --max-time 300 \
      "https://github.com/ast-grep/ast-grep/releases/download/0.45.3/app-${sg_arch}-unknown-linux-gnu.zip" -o /tmp/repokit-ast-grep.zip; \
    printf '%s  %s\n' "$sg_sha" /tmp/repokit-ast-grep.zip | sha256sum -c -; \
    /usr/bin/python3 -c 'import zipfile; zipfile.ZipFile("/tmp/repokit-ast-grep.zip").extractall("/tmp/repokit-ast-grep")'; \
    install -m 0555 /tmp/repokit-ast-grep/ast-grep /usr/local/bin/ast-grep; \
    install -m 0555 /tmp/repokit-ast-grep/sg /usr/local/bin/sg; \
    rm -rf /tmp/repokit-ast-grep /tmp/repokit-ast-grep.zip; \
    ast-grep --version | grep -F 0.45.3
COPY repokit-ddgs-requirements.txt /tmp/repokit-ddgs-requirements.txt
# --no-config and /tmp keep uv from applying Hermes's own project settings.
RUN set -eu; cd /tmp; \
    uv venv --no-config --python /usr/bin/python3 /opt/repokit-ddgs; \
    uv pip install --no-config --python /opt/repokit-ddgs/bin/python --require-hashes --no-deps -r /tmp/repokit-ddgs-requirements.txt; \
    ln -s /opt/repokit-ddgs/bin/ddgs /usr/local/bin/ddgs; \
    rm /tmp/repokit-ddgs-requirements.txt; \
    ddgs --help >/dev/null
{{GO_INSTALL}}
# Login shells reset the inherited PATH; retain the native privilege-drop shim.
RUN ln -s /opt/hermes/bin/hermes /usr/local/bin/hermes
COPY --chmod=0555 repokit-docker-test /usr/local/bin/repokit-docker-test
RUN set -eu; \
    git --version; bash --version; curl --version; jq --version; rg --version; \
    python3 --version; node --version; npm --version; make --version; gcc --version; g++ --version; \
    test -s /etc/ssl/certs/ca-certificates.crt; \
    test "$(jq --version)" = jq-1.8.2; \
    test "$(node --version)" = v26.5.1; \
    test "$(npm --version)" = 11.17.0; \
    python3 -c 'import sys; assert sys.version_info[:3] == (3, 13, 5)'; \
    printf 'int main(void){return 0;}\n' | gcc -x c - -o /tmp/repokit-cc-smoke; \
    /tmp/repokit-cc-smoke; rm /tmp/repokit-cc-smoke
WORKDIR /workspace
