#!/bin/sh
# Native Memory environment and s6 lifecycle inside the Hermes container.
# This installed script has no dependency on the bootstrap executable.
set -eu
export HOME=/opt/data/memory
export MEMORY_CONFIG_FILE=/opt/data/memory/memory.conf
export MEMORY_CLI_CONFIG_FILE=/opt/data/memory/memory-cli.conf
export MEMORY_WITH_BOT=0
export MEMORY_SERVER_HOST=127.0.0.1
export MEMORY_PENDING_HOST=127.0.0.1
export MEMORY_SERVER_PORT=1933
export LD_LIBRARY_PATH=/opt/memory-python/lib
export PATH=/app/.venv/bin:/opt/memory-python/bin:/command:/usr/local/bin:/usr/bin:/bin
unset PYTHONHOME PYTHONPATH VIRTUAL_ENV MEMORY_CONF_CONTENT
umask 077
case "${1:-}" in
    serve)
        cd /opt/data/memory
        exec /usr/local/bin/memory-entrypoint --without-bot
        ;;
    server)
        shift
        cd /opt/data/memory
        exec /app/.venv/bin/memory-server "$@"
        ;;
    python)
        shift
        exec /app/.venv/bin/python "$@"
        ;;
    health)
        # /health is observational; /ready may invoke paid embeddings.
        exec /app/.venv/bin/python -I -c '
import json, urllib.request
try:
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args, **kwargs): return None
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    with opener.open("http://127.0.0.1:1933/health", timeout=3) as response:
        data = response.read(4097)
        assert response.status == 200 and len(data) <= 4096
        assert json.loads(data).get("status") == "ok"
    print("healthy")
except Exception:
    print("degraded")
    raise SystemExit(1)
'
        ;;
    restart)
        # Restart only memory, never the gateway or its active workers.
        s6-svc -wD -T 15000 -d /run/service/repokit-memory
        exec s6-svc -wu -T 15000 -u /run/service/repokit-memory
        ;;
    *) echo 'Usage: repokit-memory {server|python|health|restart}' >&2; exit 2 ;;
esac
